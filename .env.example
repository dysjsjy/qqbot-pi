# Core v0.2: SQLite + QQ official bot. Copy to .env for: docker compose up --build -d
# Read README.md for startup and model configuration.
# Preserve an existing .env. Platforms are disabled here; the default port is 8080.
# java -jar reads .env from the current working directory; process settings take precedence.
# PI_CLI, DATABASE_URL and BOT_STATE_DIR relative paths use that same directory.
RAG_ENABLED=false
JAVA_VERSION=21
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2a$12$replace-with-a-real-bcrypt-hash'
# false for local HTTP admin access; true if the admin UI itself uses HTTPS.
COOKIE_SECURE=false
PI_PROVIDER=your-provider
PI_MODEL=your-model
PI_KEY_ENV=OPENAI_API_KEY
PI_API_KEY=replace-with-model-key
PI_BASE_URL=
# Base/idle window, hard call limit, queue limit, total chat limit (seconds).
PI_TIMEOUT_SECONDS=60
PI_MAX_TIMEOUT_SECONDS=300
PI_QUEUE_TIMEOUT_SECONDS=120
PI_REQUEST_TIMEOUT_SECONDS=420
# Memory budgets are estimates; set the window for your actual provider/model.
MEMORY_INPUT_TOKENS=8000
MEMORY_OUTPUT_TOKENS=800
MEMORY_CONTEXT_WINDOW=32768
MEMORY_SAFETY_TOKENS=1024
MEMORY_SUMMARY_OUTPUT_TOKENS=1000
BOT_HOT_WINDOW_DAYS=30
BOT_ARCHIVE_RETENTION_DAYS=0
BOT_PROCESS_RETENTION_DAYS=30
BOT_EXPERIMENTAL_MEMBER_PROFILE_ENABLED=false
MEMBER_PROFILE_POLL_MS=30000
MEMBER_PROFILE_OUTPUT_TOKENS=600
MEMBER_PROFILE_CONTEXT_TOKENS=500
MEMBER_PROFILE_MAX_INJECTED_MEMBERS=4
# Optional prices per million tokens. Empty means unknown, not free.
MEMORY_CURRENCY=USD
MEMORY_INPUT_PRICE=
MEMORY_OUTPUT_PRICE=
MEMORY_CACHE_READ_PRICE=
MEMORY_CACHE_WRITE_PRICE=
MEMORY_PRICE_VERSION=unset
# Native default is jdbc:sqlite:qqbot.db; Compose stores the DB in the state volume.
# DATABASE_URL=jdbc:sqlite:qqbot.db
# Enable RAG by setting RAG_ENABLED=true and supplying embedding settings:
EMBEDDING_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_MIN_SIMILARITY=0.65
QQ_ENABLED=false
# For an official QQ bot see .env.qq-official.example and README.md.
QQ_OFFICIAL_TRANSPORT=websocket
QQ_APP_ID=
QQ_APP_SECRET=
# Bot's own group member OpenID, if full-message @ markup differs from READY's identity.
QQ_OFFICIAL_BOT_OPENID=
QQ_OFFICIAL_API_BASE_URL=https://api.bot.qq.com
QQ_OFFICIAL_TOKEN_URL=https://api.bot.qq.com/app/getAppAccessToken
QQ_OFFICIAL_ALLOW_ACTIVE_MESSAGES=false
WEIXIN_ENABLED=false
WEIXIN_BASE_URL=
WEIXIN_ACCOUNT_ID=
WEIXIN_TOKEN=

# Docker host bindings: the admin console and bot API share BOT_PORT.
BOT_BIND_ADDRESS=127.0.0.1
BOT_PORT=8080
FRONT_BIND_ADDRESS=127.0.0.1
FRONT_PORT=8081
# Optional trace retention and worker polling (milliseconds).
# BOT_TRACE_ENABLED=true
# BOT_TRACE_RETENTION_DAYS=7
# BOT_WORKER_POLL_MS=200

# Optional RAW segments. False pauses archiving; never falls back to small files.
# RAW_ARCHIVE_ENABLED=true
# RAW_ARCHIVE_SEGMENT_BYTES=67108864
# RAW_ARCHIVE_SEGMENT_MAX_AGE_SECONDS=86400
# RAW_ARCHIVE_POLL_MS=1000
# RAW_ARCHIVE_BATCH_MESSAGES=500
# RAW_ARCHIVE_BATCH_BYTES=1048576
# RAW_ARCHIVE_INDEX_INTERVAL_BYTES=4096
# RAW_ARCHIVE_MAX_OPEN_SEGMENTS=16
# RAW_ARCHIVE_GC_POLL_MS=60000

# Optional PUBLIC website build settings. Leave empty to show local documentation paths.
# HTTPS only; repository is a GitHub homepage. Docs prefix points to repository ROOT.
# Set the actual ref in the docs prefix; do not assume main/master. Never put credentials here.
FRONT_REPOSITORY_URL=
FRONT_DOCS_BASE_URL=
FRONT_SITE_URL=
# Rebuild the front service after changing these values; startup env does not rewrite static HTML.
