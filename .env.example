# Copy to .env. Single quotes preserve BCrypt dollar signs in Compose .env.
DATABASE_PASSWORD=replace-with-random-database-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2a$12$replace-with-a-real-bcrypt-hash'
# true behind HTTPS; false only for localhost HTTP development
COOKIE_SECURE=false
PI_PROVIDER=your-provider
PI_MODEL=your-model
PI_KEY_ENV=OPENAI_API_KEY
PI_API_KEY=replace-with-model-key
# Optional: a trusted OpenAI-compatible /v1 base URL (uses openai-completions).
PI_BASE_URL=
EMBEDDING_URL=https://your-embedding-provider/v1/embeddings
EMBEDDING_API_KEY=replace-with-embedding-key
EMBEDDING_MODEL=your-fixed-model
EMBEDDING_DIMENSIONS=1536
EMBEDDING_MIN_SIMILARITY=0.65
QQ_ENABLED=false
QQ_BASE_URL=http://host.docker.internal:3000
QQ_ACCOUNT_ID=
QQ_TOKEN=
# Set OneBot HTTP POST secret to this value; mandatory for gateways without Authorization headers.
QQ_WEBHOOK_SECRET=
WEIXIN_ENABLED=false
WEIXIN_BASE_URL=
WEIXIN_ACCOUNT_ID=
WEIXIN_TOKEN=
