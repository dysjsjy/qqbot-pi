ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2a$12$replace-with-a-real-bcrypt-hash'
COOKIE_SECURE=false

PI_PROVIDER=your-provider
PI_MODEL=your-model
PI_KEY_ENV=OPENAI_API_KEY
PI_API_KEY=replace-with-model-key
PI_BASE_URL=
PI_TIMEOUT_SECONDS=60
PI_MAX_TIMEOUT_SECONDS=300
PI_QUEUE_TIMEOUT_SECONDS=120
PI_REQUEST_TIMEOUT_SECONDS=420

MEMORY_INPUT_TOKENS=8000
MEMORY_OUTPUT_TOKENS=800
MEMORY_CONTEXT_WINDOW=32768
MEMORY_SAFETY_TOKENS=1024
MEMORY_SUMMARY_OUTPUT_TOKENS=1000
# Prices per million tokens; leave empty when unknown, never assume zero.
MEMORY_CURRENCY=USD
MEMORY_INPUT_PRICE=
MEMORY_OUTPUT_PRICE=
MEMORY_CACHE_READ_PRICE=
MEMORY_CACHE_WRITE_PRICE=
MEMORY_PRICE_VERSION=unset

RAG_ENABLED=false
EMBEDDING_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_MIN_SIMILARITY=0.65

QQ_ENABLED=false
QQ_OFFICIAL_TRANSPORT=websocket
QQ_APP_ID=
QQ_APP_SECRET=
QQ_OFFICIAL_BOT_OPENID=
QQ_OFFICIAL_API_BASE_URL=https://api.bot.qq.com
QQ_OFFICIAL_TOKEN_URL=https://api.bot.qq.com/app/getAppAccessToken
QQ_OFFICIAL_ALLOW_ACTIVE_MESSAGES=false

WEIXIN_ENABLED=false
WEIXIN_BASE_URL=
WEIXIN_ACCOUNT_ID=
WEIXIN_TOKEN=

BOT_BIND_ADDRESS=127.0.0.1
BOT_PORT=8080
FRONT_BIND_ADDRESS=127.0.0.1
FRONT_PORT=8081
# Optional trace retention and worker polling (milliseconds).
# BOT_TRACE_ENABLED=true
# BOT_TRACE_RETENTION_DAYS=7
# BOT_WORKER_POLL_MS=200

# Optional RAW segments. False pauses archiving; never falls back to small files.
# RAW_ARCHIVE_ENABLED=true
# RAW_ARCHIVE_SEGMENT_BYTES=67108864
# RAW_ARCHIVE_SEGMENT_MAX_AGE_SECONDS=86400
# RAW_ARCHIVE_POLL_MS=1000
# RAW_ARCHIVE_BATCH_MESSAGES=500
# RAW_ARCHIVE_BATCH_BYTES=1048576
# RAW_ARCHIVE_INDEX_INTERVAL_BYTES=4096
# RAW_ARCHIVE_MAX_OPEN_SEGMENTS=16
# RAW_ARCHIVE_GC_POLL_MS=60000
