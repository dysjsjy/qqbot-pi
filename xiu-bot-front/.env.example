# Public build-time links. Empty/invalid values hide external links.
# GitHub homepage only: https://github.com/<owner>/<repo>
VITE_REPOSITORY_URL=
# Repository ROOT browser prefix, e.g. https://github.com/<owner>/<repo>/blob/<ref>/
# The website appends README.md section links or AGENTS.md. Set the actual ref.
VITE_DOCS_BASE_URL=
# Absolute HTTPS site ROOT URL for canonical/Open Graph metadata; does not change Vite base.
VITE_SITE_URL=
# Existing admin fallback. A browser-saved address still takes priority.
VITE_ADMIN_URL=
VITE_ADMIN_PORT=8082
# Never put credentials in VITE_ variables. Rebuild after changing these values.
