FROM node:22.22.1-bookworm-slim AS build
WORKDIR /build
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG VITE_ADMIN_PORT=8080
ARG VITE_ADMIN_URL=
ARG VITE_REPOSITORY_URL=
ARG VITE_DOCS_BASE_URL=
ARG VITE_SITE_URL=
ENV VITE_ADMIN_PORT=$VITE_ADMIN_PORT
ENV VITE_ADMIN_URL=$VITE_ADMIN_URL
ENV VITE_REPOSITORY_URL=$VITE_REPOSITORY_URL
ENV VITE_DOCS_BASE_URL=$VITE_DOCS_BASE_URL
ENV VITE_SITE_URL=$VITE_SITE_URL
RUN npm run build
FROM nginx:1.27-alpine
COPY --from=build /build/dist /usr/share/nginx/html
EXPOSE 80
